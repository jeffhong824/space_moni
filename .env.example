# Copy to `.env` for local `npm run dev` / `npm start`.
# On Vercel: Project → Settings → Environment Variables (Production / Preview / Development).
# Keys are read only on the server (`server.ts`, `api/*.ts`). Never prefix with VITE_ — that would expose them to the browser.

# --- AURA LLM (server-side only) ---
# AI_PROVIDER=gemini | openai | offline
# Unset = auto: Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else offline rules + banner.
# Explicit provider with no usable key → offline rules + banner.
AI_PROVIDER=

# Google AI Studio — https://aistudio.google.com/apikey
# Default model if unset: gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI Chat Completions (https://api.openai.com/v1/chat/completions) — https://platform.openai.com/api-keys
# Default model if unset: gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=

# --- NASA api.nasa.gov (DONKI GST / CME / SEP / notifications) ---
# Unset or DEMO_KEY = public DEMO_KEY (rate-limited; UI banner). NOAA SWPC/GOES do not use this key.
# Flare class is derived from NOAA GOES X-ray; DONKI FLR is not queried (upstream 404).
NASA_API_KEY=

# Optional public URL metadata
APP_URL=
