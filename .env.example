# GEMINI_API_KEY: Optional. Live AURA analysis via Google Gemini.
# If unset or equal to MY_GEMINI_API_KEY, the offline two-level fallback is used.
# Get a key from https://aistudio.google.com/apikey — do not commit real keys.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NASA_API_KEY: Optional. Used only for NASA DONKI event catalog.
# If unset, DEMO_KEY is used and the UI shows a non-production notice.
# Live NOAA SWPC / GOES observations do not require this key.
# Request a key at https://api.nasa.gov/
NASA_API_KEY="DEMO_KEY"

# APP_URL: Host URL for this applet (deployment metadata).
APP_URL="MY_APP_URL"
